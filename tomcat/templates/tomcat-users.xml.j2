<?xml version="1.0" encoding="UTF-8"?>

<tomcat-users xmlns="http://tomcat.apache.org/xml"
              version="1.0">

<!-- user manager can access only manager section -->

<role rolename="manager-gui" />

<user username="{{ ui_manager_user }}" password="{{ ui_manager_pass }}" roles="manager-gui" />

<!-- user admin can access manager and admin section both -->

<role rolename="admin-gui" />

<user username="{{ ui_admin_username }}" password="{{ ui_admin_pass }}" roles="manager-gui,admin-gui" />

<role rolename="manager-script"/>    
<user username="{{ ui_admin_username }}" password="{{ ui_admin_pass }}" roles="manager-gui,admin-gui,manager-script" />

<role rolename="manager-jmx"/>
<user username="{{ ui_admin_username }}" password="{{ ui_admin_pass }}" roles="manager-gui,admin-gui,manager-script,manager-jmx" />

<role rolename="manager-status"/>
<user username="{{ ui_admin_username }}" password="{{ ui_admin_pass }}" roles="manager-gui,admin-gui,manager-script,manager-status" />

<role rolename="admin-script"/>
<user username="{{ ui_admin_username }}" password="{{ ui_admin_pass }}" roles="manager-gui,admin-gui,manager-script,admin-script" />

</tomcat-users>